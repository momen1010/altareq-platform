{
  "name": "altareq-arabic-platform",
  "version": "1.0.0",
  "description": "منصة ال طارق لتعليم اللغة العربية — منصة تعليمية ثنائية اللغة (عربي/إنجليزي) مبنية على مشروع منهل مفتوح المصدر (MIT).",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test --test-reporter=spec \"test/*.test.js\"",
    "build:demo": "node scripts/build-demo.js",
    "backup": "node scripts/backup.js",
    "deploy:demo": "node scripts/build-demo.js && firebase deploy --only hosting"
  },
  "license": "MIT"
}
